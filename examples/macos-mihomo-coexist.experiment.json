{
  "nmd_experiment": {
    "id": "macos-mihomo-official-tailscale",
    "platform": "macos",
    "status": "experimental",
    "auto_enable": false,
    "production_stable": false,
    "linux_home_default_unchanged": true,
    "windows": "deferred",
