    "tailscale_exit_node": false,
    "group": "NMD-EXIT",
    "server_placeholder": true,
    "server": "203.0.113.20",
    "port": 1080,
    "interface_discovery": "dynamic"
  },
  "tun": {
    "enable": true,
    "auto_route": true,
    "auto_detect_interface": true,
    "observed_address": "198.18.0.1/30",
    "route_exclude_address": [
      "100.64.0.0/10",
      "fd7a:115c:a1e0::/48"
    ]
  },
  "dns_mode": {
    "field": "tun.dns-mode",
